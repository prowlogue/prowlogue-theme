# Cloudflare Pages response headers. tools/build.mjs copies this file into dist/.
#
# Browsers check for a new file on every full page load and get a 304 when nothing changed, so a deploy
# reaches users the next time they load Jellyfin. Cloudflare-CDN-Cache-Control keeps the domain's own
# cache out of it: on a custom domain that cache raises what it stores to 4 hours in the browser.
/*
  Cache-Control: no-cache
  Cloudflare-CDN-Cache-Control: no-store
